{
  "name": "libros-backend",
  "version": "1.3.0",
  "description": "Backend de libros con Node.js, SQL Server (Stored Procedures, autenticación de Windows) y Swagger (Dark Mode)",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=18.19"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "crear-bd": "node src/crear-bd.js"
  },
  "nodemonConfig": {
    "watch": ["src", ".env"],
    "ext": "js,json,env",
    "ignore": ["data/*", "src/crear-bd.js"]
  },
  "keywords": ["node", "express", "sqlserver", "books", "swagger"],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^6.11.2",
    "helmet": "^7.0.0",
    "mssql": "^12.7.6",
    "swagger-ui-express": "^5.0.0",
    "swagger-jsdoc": "^6.2.8"
  },
  "optionalDependencies": {
    "msnodesqlv8": "^5.6.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
